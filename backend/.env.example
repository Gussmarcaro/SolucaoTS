# PostgreSQL
DATABASE_URL="postgresql://solucaots:solucaots@localhost:5432/solucaots?schema=public"

# Servidor
PORT=3333
NODE_ENV=development

# CORS — em produção, informe a URL do frontend (ex.: https://seu-app.vercel.app).
# Aceita múltiplas origens separadas por vírgula. Vazio = libera todas (só em dev).
CORS_ORIGIN=

# Autenticação (JWT) — use um segredo longo e aleatório em produção
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES="8h"          # duração padrão do token
JWT_EXPIRES_REMEMBER="30d" # duração quando "Lembrar de mim" está ativo

# URL do frontend (usada no link de redefinição de senha)
APP_URL="http://localhost:5173"

# Recuperação de senha
RESET_TOKEN_TTL_MIN=30 # validade do token de recuperação em minutos

# Envio de e-mail (SMTP). É por aqui que sai o link de redefinição de senha —
# o único e-mail que o sistema manda.
#
# SEM estas variáveis o link vai para o CONSOLE do servidor, não para a caixa
# do usuário. Serve ao desenvolvimento; em produção significa que ninguém
# recupera a senha sozinho. A API avisa no boot quando está nesse modo.
#
# A porta decide o modo e é o erro mais comum: 465 = TLS desde o início;
# 587 = STARTTLS. SMTP_SECURE só é preciso para contrariar esse padrão.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=          # ex.: "Solução TS <suporte@seudominio.com>"; vazio usa SMTP_USER
# SMTP_SECURE=true

# Saltos de proxy à frente da API (Render/Nginx = 1). Vazio: 1 em produção,
# nenhum em desenvolvimento. Necessário para o limite de tentativas de login
# enxergar o IP real de cada cliente, e não o do proxy.
TRUST_PROXY=

# Agregacao de erros (opcional). Sem a variavel, nada e enviado para fora.
#
# Como obter: sentry.io -> criar projeto do tipo "Node.js" -> Settings ->
# Client Keys (DSN). O plano gratuito cobre o volume de um sistema deste porte.
#
# O que sai daqui: tipo do erro, stack (sem valores de variavel), rota
# normalizada, id da requisicao e o orgao como tag. Nao sai corpo de
# requisicao, cabecalho, cookie, query string, parametro de SQL, nem o id/nome
# de quem operava. Ver `shared/monitoramento.ts` — cada categoria e desligada
# explicitamente, porque os padroes do SDK sao permissivos.
#
# Se o contrato exigir residencia de dados, crie o projeto na regiao da UE:
# o DSN muda de host (`o123.ingest.de.sentry.io`), e so.
SENTRY_DSN=

# Versao publicada, para o painel agrupar erro por release. Opcional; sem ela
# o Sentry agrupa tudo junto e "isso comecou no deploy de ontem?" fica sem
# resposta. No deploy: APP_RELEASE=$(git rev-parse --short HEAD)
APP_RELEASE=
