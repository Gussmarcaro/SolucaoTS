    "prisma:studio": "prisma studio",
    "dominios:gerar": "tsx scripts/gerarDominios.ts",
    "dominios:seed": "tsx prisma/seeds/dominios.ts",
    "dominios:fase-v": "tsx scripts/gerarDominiosFaseV.ts",
    "verificar:montador": "tsx scripts/verificarMontador.ts",
    "verificar:auditoria": "tsx scripts/verificarAuditoria.ts",
    "assistente:base": "tsx scripts/gerarBaseAssistente.ts",
    "verificar:assistente": "tsx scripts/verificarAssistente.ts",
    "verificar:alertas": "tsx scripts/verificarAlertas.ts",
    "permissoes:seed": "tsx prisma/seeds/permissoes.ts",
    "verificar:permissoes": "tsx scripts/verificarPermissoes.ts",
