  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@prisma/client": "^5.19.1",
    "@sentry/node": "^10.70.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "tsx": "^4.19.0"
