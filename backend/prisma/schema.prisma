// ============================================================================
// DOMÍNIO: WORKFLOW (Gestão de Projetos e Tarefas / prazos legais)
// ============================================================================

model Projeto {
  id        String  @id @default(uuid()) @db.Uuid
  clienteId String  @db.Uuid
  ajusteId  String? @db.Uuid
  nome      String

  cliente Cliente  @relation(fields: [clienteId], references: [id])
  ajuste  Ajuste?  @relation(fields: [ajusteId], references: [id])
  tarefas Tarefa[]

  @@index([clienteId])
}

model Tarefa {
  id            String           @id @default(uuid()) @db.Uuid
  projetoId     String           @db.Uuid
  responsavelId String?          @db.Uuid
  titulo        String
  descricao     String?
  prioridade    PrioridadeTarefa @default(MEDIA)
  prazoLegal    DateTime         @db.Date
  status        StatusTarefa     @default(PENDENTE)
  criadoEm      DateTime         @default(now())

  projeto     Projeto  @relation(fields: [projetoId], references: [id])
  responsavel Usuario? @relation(fields: [responsavelId], references: [id])

  @@index([projetoId])
  @@index([prazoLegal])
}

// ============================================================================
// TABELAS DE DOMÍNIO OFICIAIS (somente leitura — carregadas por seed)
// ============================================================================
// Códigos publicados pelo TCESP/MTE. NÃO são editáveis pela aplicação: são
// recarregados pelo seed (`npm run seed:dominios`) a partir dos arquivos em
// `Documentação/`. Informar código inexistente causa rejeição no envio, por
// isso os formulários consultam estas tabelas em vez de aceitar texto livre.

// Código Brasileiro de Ocupações (CBO 2002) — campo `cbo` da Relação de
// Empregados. O subgrupo 225 identifica médicos, para quem o CNS é exigido.
model Cbo {
  codigo     String @id @db.VarChar(6)
  titulo     String
  buscaTexto String // título normalizado (sem acento/caixa) para busca

  @@index([buscaTexto])
}

// Tabela Auxiliar "Classificação Econômica da Despesa" do TCESP — campo
// `classificacao_economica_tipo` dos Empenhos. A validade é por exercício e
// por esfera do ente (E=Estado, M=Municípios, C=Consórcios).
model ClassificacaoEconomica {
  codigo       String  @db.VarChar(8) // categoria+grupo+modalidade+elemento+subelemento
  exercicio    Int
  categoria    String  @db.VarChar(1)
  grupo        String  @db.VarChar(1)
  modalidade   String  @db.VarChar(2)
  elemento     String  @db.VarChar(2)
  subelemento  String  @db.VarChar(2)
  nome         String
  escrituracao String? // 'E' = obrigatório na execução · 'O' = só orçamento
  entes        String // combinação de E/M/C conforme a planilha
  situacao     String? // INCLUSAO/ALTERACAO nesta edição (excluídos não são carregados)
  buscaTexto   String

  @@id([exercicio, codigo])
  @@index([buscaTexto])
}

// Tabelas auxiliares que compõem a classificação econômica (mesmas planilhas).
// `tipo` distingue: CATEGORIA_ECONOMICA, GRUPO_NATUREZA, MODALIDADE_APLICACAO,
// ELEMENTO_DESPESA.
model ComponenteDespesa {
  tipo       String
  codigo     String @db.VarChar(2)
  nome       String
  buscaTexto String

  @@id([tipo, codigo])
}

// ============================================================================
// AUDITORIA
// ============================================================================
// Trilha de alterações e exclusões, gravada pela extension do Prisma Client
// (`extensaoAuditoria`). A tabela é **append-only**: a aplicação nunca atualiza
// nem exclui um registro daqui, e ela fica fora da própria auditoria.
//
// Criação de cadastro NÃO gera registro: a autoria da inclusão fica no campo
// `criadoPor` do próprio cadastro.

enum AcaoAuditoria {
  ALTERACAO
  EXCLUSAO
  INATIVACAO // soft delete: `ativo` passou a false
  REATIVACAO // `ativo` voltou a true
  CRIACAO // só para blocos da prestação, que não têm `criadoPor`
}

model RegistroAuditoria {
  id                String        @id @default(uuid()) @db.Uuid
  ocorridoEm        DateTime      @default(now())
  // Autor desnormalizado: o log precisa continuar legível se o usuário for
  // excluído depois. Sem FK, pelo mesmo motivo.
  usuarioId         String?       @db.Uuid
  usuarioNome       String        @default("(sistema)")
  entidade          String // nome do model, ex.: "Fornecedor"
  registroId        String // id do registro afetado
  // Descrição legível do registro no momento do evento (razão social, nome,
  // número). Capturada aqui porque, após a exclusão, não há mais onde lê-la.
  registroDescricao String?
  acao              AcaoAuditoria
  // ALTERACAO: só os campos que mudaram, como { campo: { de, para } }.
  // EXCLUSAO: o registro completo, é a última chance de saber o que havia.
  alteracoes        Json?
  rota              String? // ex.: "PUT /api/fornecedores/:id"

  @@index([entidade, registroId])
  @@index([ocorridoEm])
  @@index([usuarioId])
}
