// ============================================================================
// Solução TS — Schema Prisma (PostgreSQL)
// Modelo de dados alinhado ao domínio real da Audesp Fase V (TCESP).
// Ver: Documentação/REGRAS_NEGOCIO_FASE_V.md
// Convenções: PKs UUID, dinheiro em Decimal(15,2), datas em @db.Date,
// nomes de campos em português (aderentes ao domínio/JSON do TCESP).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS DE DOMÍNIO
// ============================================================================

enum TipoOrgao {
  PREFEITURA_MUNICIPAL
  CAMARA
  AUTARQUIA_MUNICIPAL
  CONSORCIO_MUNICIPAL
  FUNDACAO_MUNICIPAL
  FUNDO_PREVIDENCIA_MUNICIPAL
  EMPRESA_PUBLICA
  UNIDADE_SECRETARIA
}

enum Periodicidade {
  ANUAL
  QUADRIMESTRAL
}

enum TipoAjuste {
  CONTRATO_GESTAO
  CONVENIO
  TERMO_COLABORACAO
  TERMO_FOMENTO
  TERMO_PARCERIA
}

// Situação do cadastro do Ajuste (módulo Ajustes)
enum StatusAjuste {
  EM_ELABORACAO
  ENVIADO
}

// Estado do envio da Prestação de Contas (retorno da API do TCESP)
enum StatusPrestacao {
  EM_ELABORACAO // rascunho local, ainda não transmitido
  ENVIADO // transmitido, aguardando processamento
  ARMAZENADO // aceito
  REJEITADO // com inconformidades
  SUBSTITUIDO // por uma retificação posterior
  EXCLUIDO
}

enum AcaoPermissao {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
}

enum PrioridadeTarefa {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

// Compromissos que aparecem no acompanhamento de parcerias. Os quatro
// primeiros vêm da Lei 13.019/2014 (arts. 58-59: monitoramento e avaliação).
enum TipoCompromisso {
  REUNIAO_MONITORAMENTO
  VISITA_IN_LOCO
  COMISSAO_AVALIACAO
  AUDIENCIA_PUBLICA
  TCESP // sessão, audiência ou prazo com hora marcada no Tribunal
  OUTRO
}

// Um compromisso **acontece** — não vence. Por isso não tem "atrasado":
// ou foi realizado, ou foi cancelado, ou ainda está por vir.
enum StatusCompromisso {
  AGENDADO
  REALIZADO
  CANCELADO
}

/// Quem enxerga o compromisso. A ordem é de precedência: PARTICULAR vence.
enum VisibilidadeCompromisso {
  PARTICULAR // só o criador — nem administrador vê
  RESTRITO // criador + participantes + membros dos grupos convidados
  ORGAO // todos do órgão
}

enum Recorrencia {
  NAO_REPETE
  DIARIA
  SEMANAL
  MENSAL
  ANUAL
}

// 1=CPF, 2=CNPJ, 3=RNE (estrangeiro)
enum TipoDocumento {
  CPF
  CNPJ
  RNE
}

enum TipoVigencia {
  PRE_ESTABELECIDA // 1
  INDETERMINADA // 2
}

enum MeioPagamento {
  BANCO // 1
  FUNDO_FIXO // 2
}

// Espécie do documento fiscal — CONTROLE INTERNO, não transmitida.
//
// O bloco "documentos_fiscais" do schema v1.14 tem 11 campos e nenhum de
// espécie (só categoria_despesas_tipo e rateio_proveniente_tipo), com
// additionalProperties: false. Sem código oficial a que se ancorar, a lista é
// a do órgão e vale como enum: fechada, conferida pelo banco, e sem número
// inventado que pudesse ser confundido com tabela do TCESP.
// Retenção do documento fiscal — CONTROLE INTERNO, não transmitida.
//
// O TCESP recebe só o VALOR (valor_encargos, obrigatório e numérico); qual
// tributo foi retido não tem campo no schema. Serve à conferência do órgão.
enum TipoRetencao {
  IRRF
  ISSQN
  PIS
  COFINS
  IR
  CSSL
}

enum TipoDocumentoFiscal {
  NOTA_FISCAL
  NOTA_FISCAL_ELETRONICA
  NOTA_PRESTACAO_SERVICOS
  NOTA_PRESTACAO_SERVICOS_ELETRONICA
  RECIBO
  FATURA
}

enum ResultadoAnaliseGlosa {
  APROVADO // 1
  APROVADO_PARCIALMENTE // 2  -> exige valor_glosa
  REPROVADO // 3
}

enum ConclusaoRelatorio {
  FAVORAVEL_SEM_RESSALVAS // 1
  FAVORAVEL_COM_RESSALVAS // 2
  DESFAVORAVEL // 3  -> exige justificativa
}

enum ResultadoMeta {
  CUMPRIDA // 1
  NAO_CUMPRIDA // 2
  CUMPRIDA_PARCIALMENTE // 3
}

// ============================================================================
// DOMÍNIO: CADASTROS E SEGURANÇA
// ============================================================================

model Cliente {
  id              String        @id @default(uuid()) @db.Uuid
  nome            String // ex: PREFEITURA MUNICIPAL DE ADAMANTINA
  codigoMunicipio Int // código do município no TCESP (1-9999)
  codigoEntidade  Int // código da entidade no TCESP (1-99999)
  tipoOrgao       TipoOrgao
  periodicidade   Periodicidade
  cnpj            String        @unique @db.VarChar(14)
  buscaTexto      String        @default("") // texto normalizado (sem acento/caixa) para busca global
  ativo           Boolean       @default(true)
  criadoPor       String?       @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt

  usuarios              Usuario[]
  grupos                GrupoUsuario[]
  entidadesBeneficiaria EntidadeBeneficiaria[]
  certidoes             Certidao[]
  ajustes               Ajuste[]
  projetos              Projeto[]
  tarefas               Tarefa[]
  compromissos          Compromisso[]
  empresas              Empresa[]
  fornecedores          Fornecedor[]
  colaboradores         Colaborador[]
  contratosFirmados     ContratoFirmado[]
  bensCedidos           BemCedido[]
  servidoresCedidos     ServidorCedidoCadastro[]

  @@unique([codigoMunicipio, codigoEntidade])
  @@index([tipoOrgao])
}

model Usuario {
  id                  String    @id @default(uuid()) @db.Uuid
  clienteId           String?   @db.Uuid // opcional até o multi-tenant/auth (Fase 1)
  grupoUsuarioId      String?   @db.Uuid // grupo de acesso (1 grupo por usuário)
  nome                String // Nome completo (usuário do sistema é sempre pessoa física)
  documento           String    @unique @db.VarChar(14) // CPF — só dígitos (11). Chave de duplicidade.
  cep                 String    @db.VarChar(8)
  logradouro          String
  numero              String?   @db.VarChar(20)
  complemento         String?
  bairro              String
  cidade              String
  uf                  String    @db.VarChar(2)
  email               String    @unique
  celular             String    @db.VarChar(11)
  buscaTexto          String    @default("") // texto normalizado (sem acento/caixa) para busca global
  senhaHash           String? // hash bcrypt da senha de login
  resetTokenHash      String?   @db.VarChar(64) // SHA-256 do token de recuperação (nunca o token puro)
  resetTokenExpiresAt DateTime? // validade do token de recuperação
  // Equipe do fornecedor: provisiona órgãos novos e atende clientes trocando
  // de órgão explicitamente. É uma marca **por usuário**, e não um nome de
  // grupo, de propósito: grupo é cadastro livre, e qualquer um que criasse um
  // chamado "Suporte" furaria o isolamento inteiro. Só se concede pelo
  // comando `suporte:conceder`, nunca pela interface.
  suporte             Boolean   @default(false)
  ativo               Boolean   @default(true)
  criadoPor           String?   @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  cliente      Cliente?                  @relation(fields: [clienteId], references: [id])
  grupoUsuario GrupoUsuario?             @relation(fields: [grupoUsuarioId], references: [id])
  grupos       UsuarioGrupo[]
  tarefas      Tarefa[]
  compromissos Compromisso[]
  convites     CompromissoParticipante[]
  prestacoes   PrestacaoContas[]         @relation("PrestacaoResponsavel")

  @@index([clienteId])
  @@index([grupoUsuarioId])
  @@index([cidade])
  @@index([uf])
  @@index([resetTokenHash])
}

// Dados da Empresa / Contratante (suporta multi-empresa / filiais)
model Empresa {
  id                 String   @id @default(uuid()) @db.Uuid
  clienteId          String?  @db.Uuid // órgão dono do registro — opcional até o backfill
  razaoSocial        String
  nomeFantasia       String?
  cnpj               String   @unique @db.VarChar(14) // só dígitos — trava de duplicidade
  inscricaoEstadual  String?  @db.VarChar(20)
  inscricaoMunicipal String?  @db.VarChar(20)
  cep                String   @db.VarChar(8)
  logradouro         String
  numero             String?  @db.VarChar(20)
  complemento        String?
  bairro             String
  cidade             String
  uf                 String   @db.VarChar(2)
  email              String
  telefoneFixo       String?  @db.VarChar(11)
  whatsapp           String?  @db.VarChar(11)
  buscaTexto         String   @default("") // texto normalizado (sem acento/caixa) para busca global
  ativo              Boolean  @default(true) // soft delete
  criadoPor          String?  @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  cliente Cliente? @relation(fields: [clienteId], references: [id])

  @@unique([clienteId, cnpj])
  @@index([clienteId])
  @@index([cidade])
  @@index([uf])
  @@index([ativo])
}

// Fornecedores / Prestadores (credores de documentos fiscais e contratos)
model Fornecedor {
  id                String        @id @default(uuid()) @db.Uuid
  clienteId         String?       @db.Uuid // órgão dono do registro — opcional até o backfill
  nome              String // Nome Completo / Razão Social
  documento         String        @unique @db.VarChar(14) // CPF (11) ou CNPJ (14), só dígitos
  documentoTipo     TipoDocumento // CPF | CNPJ
  inscricaoEstadual String?       @db.VarChar(20)
  cep               String        @db.VarChar(8)
  logradouro        String
  numero            String?       @db.VarChar(20)
  complemento       String?
  bairro            String
  cidade            String
  uf                String        @db.VarChar(2)
  email             String
  telefoneFixo      String?       @db.VarChar(11)
  whatsapp          String?       @db.VarChar(11)
  buscaTexto        String        @default("") // texto normalizado para busca global
  ativo             Boolean       @default(true) // soft delete
  criadoPor         String?       @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  criadoEm          DateTime      @default(now())
  atualizadoEm      DateTime      @updatedAt

  cliente Cliente? @relation(fields: [clienteId], references: [id])

  @@unique([clienteId, documento])
  @@index([clienteId])
  @@index([cidade])
  @@index([uf])
  @@index([ativo])
}

// Colaboradores / Empregados da entidade beneficiária (bloco "Relação de Empregados")
model Colaborador {
  id                String    @id @default(uuid()) @db.Uuid
  clienteId         String?   @db.Uuid // órgão dono do registro — opcional até o backfill
  nome              String
  cpf               String    @unique @db.VarChar(11) // só dígitos
  cargo             String // função / cargo
  cbo               String?   @db.VarChar(6) // Classificação Brasileira de Ocupações
  cns               String?   @db.VarChar(15) // Cartão Nacional de Saúde (profissionais de saúde)
  dataAdmissao      DateTime  @db.Date
  dataDemissao      DateTime? @db.Date
  salarioContratual Decimal   @db.Decimal(15, 2)
  buscaTexto        String    @default("") // texto normalizado para busca global
  ativo             Boolean   @default(true) // soft delete
  criadoPor         String?   @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  cliente Cliente? @relation(fields: [clienteId], references: [id])

  @@unique([clienteId, cpf])
  @@index([clienteId])
  @@index([nome])
  @@index([cargo])
  @@index([ativo])
}

// Cadastro de Contratos firmados pela entidade beneficiária (precede o bloco de
// prestação `Contrato`, que é a versão transmitida ao TCESP).
model ContratoFirmado {
  id                  String        @id @default(uuid()) @db.Uuid
  clienteId           String?       @db.Uuid // órgão dono do registro — opcional até o backfill
  numero              String
  credorNome          String
  credorDocumento     String        @db.VarChar(14) // CPF (11) ou CNPJ (14), só dígitos
  credorDocumentoTipo TipoDocumento // CPF | CNPJ
  naturezaContratacao String // ex.: Compras, Serviços, Obras, Locação
  objeto              String
  dataAssinatura      DateTime      @db.Date
  vigenciaInicio      DateTime      @db.Date
  vigenciaFim         DateTime?     @db.Date // nulo = vigência indeterminada
  valorMontante       Decimal       @db.Decimal(15, 2)
  buscaTexto          String        @default("") // texto normalizado para busca global
  ativo               Boolean       @default(true) // soft delete
  criadoPor           String?       @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  criadoEm            DateTime      @default(now())
  atualizadoEm        DateTime      @updatedAt

  cliente Cliente? @relation(fields: [clienteId], references: [id])

  @@unique([numero, credorDocumento])
  @@index([clienteId])
  @@index([dataAssinatura])
  @@index([ativo])
}

// Cadastro de Bens Cedidos (standalone) — distinto do BemCedidoCadastro do Ajuste
model BemCedido {
  id            String    @id @default(uuid()) @db.Uuid
  clienteId     String?   @db.Uuid // órgão dono do registro — opcional até o backfill
  descricao     String
  tipo          String // Móvel, Imóvel, Veículo, Equipamento, Outros
  identificador String    @unique // nº de patrimônio / placa / identificação
  valor         Decimal   @db.Decimal(15, 2)
  dataCessao    DateTime  @db.Date
  dataDevolucao DateTime? @db.Date
  observacao    String?
  buscaTexto    String    @default("")
  ativo         Boolean   @default(true)
  criadoPor     String?   @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  cliente Cliente? @relation(fields: [clienteId], references: [id])

  @@unique([clienteId, identificador])
  @@index([clienteId])
  @@index([tipo])
  @@index([ativo])
}

// Cadastro de Servidores Cedidos (standalone) — precede o bloco de prestação ServidorCedido
model ServidorCedidoCadastro {
  id                String    @id @default(uuid()) @db.Uuid
  clienteId         String?   @db.Uuid // órgão dono do registro — opcional até o backfill
  nome              String
  cpf               String    @unique @db.VarChar(11) // só dígitos
  cargoPublico      String
  funcaoEntidade    String
  onusPagamento     String // "Com ônus (cedente)" | "Sem ônus (cessionária)"
  cargaHoraria      Int? // horas semanais
  remuneracaoBruta  Decimal   @db.Decimal(15, 2)
  dataInicialCessao DateTime  @db.Date
  dataFinalCessao   DateTime? @db.Date
  buscaTexto        String    @default("")
  ativo             Boolean   @default(true)
  criadoPor         String?   @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  cliente Cliente? @relation(fields: [clienteId], references: [id])

  @@unique([clienteId, cpf])
  @@index([clienteId])
  @@index([nome])
  @@index([ativo])
}

model GrupoUsuario {
  id           String   @id @default(uuid()) @db.Uuid
  clienteId    String?  @db.Uuid // opcional até o multi-tenant/auth
  // Único **por órgão**, não no sistema (ver `@@unique` abaixo). É a exceção
  // entre as oito chaves de duplicidade: cnpj e cpf identificam a mesma pessoa
  // em qualquer lugar, mas dois órgãos têm legitimamente um grupo chamado
  // "Administrador" — a trava global aqui não protegia nada e impedia
  // provisionar o segundo cliente.
  nome         String
  descricao    String?
  buscaTexto   String   @default("") // texto normalizado para busca global
  ativo        Boolean  @default(true) // status Ativo/Inativo
  criadoPor    String?  @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente      Cliente?                @relation(fields: [clienteId], references: [id])
  membros      Usuario[] // usuários vinculados (1 grupo por usuário)
  usuarios     UsuarioGrupo[] // legado RBAC N:N (não usado ainda)
  permissoes   GrupoUsuarioPermissao[]
  compromissos CompromissoGrupo[]

  @@unique([clienteId, nome])
  @@index([ativo])
}

model UsuarioGrupo {
  usuarioId String       @db.Uuid
  grupoId   String       @db.Uuid
  usuario   Usuario      @relation(fields: [usuarioId], references: [id])
  grupo     GrupoUsuario @relation(fields: [grupoId], references: [id])

  @@id([usuarioId, grupoId])
}

model Permissao {
  id        String        @id @default(uuid()) @db.Uuid
  modulo    String // ex: "AUDESP_AJUSTES", "AUDESP_PRESTACAO", "WORKFLOW_TAREFAS"
  acao      AcaoPermissao
  descricao String

  grupos GrupoUsuarioPermissao[]

  @@unique([modulo, acao])
}

model GrupoUsuarioPermissao {
  grupoId     String       @db.Uuid
  permissaoId String       @db.Uuid
  grupo       GrupoUsuario @relation(fields: [grupoId], references: [id])
  permissao   Permissao    @relation(fields: [permissaoId], references: [id])

  @@id([grupoId, permissaoId])
}

// ============================================================================
// DOMÍNIO: AUDESP FASE V — MÓDULO CADASTRO (Ajuste, Certidão, Plano de Trabalho)
// ============================================================================

model EntidadeBeneficiaria {
  id                 String    @id @default(uuid()) @db.Uuid
  clienteId          String?   @db.Uuid // opcional até o multi-tenant/auth
  razaoSocial        String
  nomeFantasia       String?
  cnpj               String    @unique @db.VarChar(14) // só dígitos — trava de duplicidade
  inscricaoEstadual  String?   @db.VarChar(20)
  inscricaoMunicipal String?   @db.VarChar(20)
  dataConstituicao   DateTime? @db.Date

  // Finalidade estatutária
  finalidadeDescricao String? // o que o estatuto define como finalidade da OSC
  finalidadeArtigo    String? @db.VarChar(120) // artigo do estatuto que a define

  // Estatuto — o PDF mora no próprio banco (não há storage externo no projeto).
  // `estatutoArquivo` NUNCA entra no select padrão nem na trilha de auditoria:
  // é o único campo do schema que pode ter megabytes.
  estatutoArquivo        Bytes?
  estatutoArquivoNome    String?
  estatutoArquivoTamanho Int? // bytes, para exibir sem carregar o conteúdo
  estatutoDataInicial    DateTime? @db.Date
  estatutoDataAlteracao  DateTime? @db.Date

  cep          String   @db.VarChar(8)
  logradouro   String
  numero       String?  @db.VarChar(20)
  complemento  String?
  bairro       String
  cidade       String
  uf           String   @db.VarChar(2)
  email        String
  telefoneFixo String?  @db.VarChar(11)
  whatsapp     String?  @db.VarChar(11)
  buscaTexto   String   @default("") // texto normalizado para busca global
  ativo        Boolean  @default(true) // soft delete
  criadoPor    String?  @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente   Cliente?   @relation(fields: [clienteId], references: [id])
  ajustes   Ajuste[]
  certidoes Certidao[]

  membrosDiretoria       MembroDiretoria[]
  membrosConselho        MembroConselho[]
  documentosRegularidade DocumentoRegularidade[]
  atasDiretoria          AtaDiretoriaArquivo[]

  @@unique([clienteId, cnpj])
  @@index([cidade])
  @@index([uf])
  @@index([ativo])
}

// ---------------------------------------------------------------------------
// Complementos da Entidade Beneficiária (abas Diretoria, Conselhos e
// Regularidade Fiscal/Cadastral). Todos existem apenas vinculados a uma
// entidade — daí o FK obrigatório e o onDelete: Cascade.
// ---------------------------------------------------------------------------

enum TipoConselho {
  ADMINISTRACAO
  FISCAL
  ESPECIAIS
}

// Tipos de documento da aba Regularidade Fiscal / Cadastral. Todos são únicos
// por entidade, exceto OUTRAS, que aceita vários registros.
enum TipoDocumentoRegularidade {
  FEDERAL
  ESTADUAL
  MUNICIPAL
  FGTS
  TRABALHISTA
  CEBAS
  UTILIDADE_PUBLICA
  ENTIDADE_BENEFICENTE
  OUTRAS
}

model MembroDiretoria {
  id                     String    @id @default(uuid()) @db.Uuid
  entidadeBeneficiariaId String    @db.Uuid
  nome                   String
  cpf                    String?   @db.VarChar(11) // só dígitos
  dataNascimento         DateTime? @db.Date
  cep                    String?   @db.VarChar(8)
  logradouro             String?
  numero                 String?   @db.VarChar(20)
  complemento            String?
  bairro                 String?
  cidade                 String?
  uf                     String?   @db.VarChar(2)
  email                  String?
  telefone               String?   @db.VarChar(11)
  cargo                  String?

  // Vigência
  dataEntrada DateTime? @db.Date
  dataSaida   DateTime? @db.Date // vazia enquanto o membro está ativo

  // Ata de eleição
  ataDataEleicao   DateTime? @db.Date
  ataDataRegistro  DateTime? @db.Date
  ataLocalRegistro String?

  // Remuneração e sua previsão estatutária
  possuiRemuneracao    Boolean @default(false)
  remuneracaoDescricao String?
  remuneracaoArtigo    String?
  /// Valores da remuneração. Json porque os campos ainda não estão definidos —
  /// acrescentar um não exige migração.
  remuneracaoValores   Json?

  criadoPor    String?  @db.Uuid
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  entidade EntidadeBeneficiaria @relation(fields: [entidadeBeneficiariaId], references: [id], onDelete: Cascade)

  @@index([entidadeBeneficiariaId])
}

// Atas de eleição da diretoria — vários arquivos por entidade, já que uma ata
// elege a composição inteira, não um membro isolado.
model AtaDiretoriaArquivo {
  id                     String   @id @default(uuid()) @db.Uuid
  entidadeBeneficiariaId String   @db.Uuid
  arquivoNome            String
  arquivoTamanho         Int
  arquivo                Bytes // fora do select padrão e da auditoria
  criadoPor              String?  @db.Uuid
  criadoEm               DateTime @default(now())

  entidade EntidadeBeneficiaria @relation(fields: [entidadeBeneficiariaId], references: [id], onDelete: Cascade)

  @@index([entidadeBeneficiariaId])
}

model MembroConselho {
  id                     String       @id @default(uuid()) @db.Uuid
  entidadeBeneficiariaId String       @db.Uuid
  tipoConselho           TipoConselho
  nome                   String
  cpf                    String?      @db.VarChar(11)
  dataNascimento         DateTime?    @db.Date
  cep                    String?      @db.VarChar(8)
  logradouro             String?
  numero                 String?      @db.VarChar(20)
  complemento            String?
  bairro                 String?
  cidade                 String?
  uf                     String?      @db.VarChar(2)
  email                  String?
  telefone               String?      @db.VarChar(11)
  cargo                  String?

  // Vigência
  dataEntrada DateTime? @db.Date
  dataSaida   DateTime? @db.Date

  // Ata de nomeação (com o PDF anexo)
  ataDataNomeacao   DateTime? @db.Date
  ataDataRegistro   DateTime? @db.Date
  ataLocalRegistro  String?
  ataArquivo        Bytes? // fora do select padrão e da auditoria
  ataArquivoNome    String?
  ataArquivoTamanho Int?

  criadoPor    String?  @db.Uuid
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  entidade EntidadeBeneficiaria @relation(fields: [entidadeBeneficiariaId], references: [id], onDelete: Cascade)

  @@index([entidadeBeneficiariaId])
  @@index([tipoConselho])
}

model DocumentoRegularidade {
  id                     String                    @id @default(uuid()) @db.Uuid
  entidadeBeneficiariaId String                    @db.Uuid
  tipo                   TipoDocumentoRegularidade

  arquivoNome    String? // nome exibido; vem do arquivo quando não informado
  arquivo        Bytes? // fora do select padrão e da auditoria
  arquivoTamanho Int?

  dataGeracao    DateTime? @db.Date
  dataVencimento DateTime? @db.Date
  publicacao     String? // CEBAS e Outras
  orgaoEmissor   String? // Utilidade Pública, Entidade Beneficente
  legislacao     String?
  data           DateTime? @db.Date

  criadoPor    String?  @db.Uuid
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  entidade EntidadeBeneficiaria @relation(fields: [entidadeBeneficiariaId], references: [id], onDelete: Cascade)

  @@index([entidadeBeneficiariaId])
  @@index([tipo])
}

// Documento eletrônico que cadastra responsáveis e beneficiária no momento da assinatura.
model Certidao {
  id                     String    @id @default(uuid()) @db.Uuid
  clienteId              String    @db.Uuid
  entidadeBeneficiariaId String?   @db.Uuid
  tipo                   String // ex: "Dados Gerais - OSC", "Corpo Diretivo", "Conselho"...
  descricao              String
  vigenciaInicial        DateTime? @db.Date
  vigenciaFinal          DateTime? @db.Date
  concluida              Boolean   @default(false)

  criadoPor            String?               @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  cliente              Cliente               @relation(fields: [clienteId], references: [id])
  entidadeBeneficiaria EntidadeBeneficiaria? @relation(fields: [entidadeBeneficiariaId], references: [id])

  @@index([entidadeBeneficiariaId])
  @@index([clienteId])
}

// Entidade CENTRAL do domínio (substitui o antigo "Convenio").
model Ajuste {
  id                     String        @id @default(uuid()) @db.Uuid
  clienteId              String?       @db.Uuid // opcional até o multi-tenant/auth (Fase 1)
  entidadeBeneficiariaId String        @db.Uuid
  tipoAjuste             TipoAjuste
  descricaoResumida      String?       @db.VarChar(80) // descrição curta do ajuste, para identificar na tela (o TCESP não recebe)
  codigoAjuste           String        @unique @db.VarChar(30) // código único do TCESP (trava de duplicidade — voltará a ser composto com clienteId no multi-tenant)
  numero                 String?
  objeto                 String
  valorGlobal            Decimal       @db.Decimal(15, 2)
  dataAssinatura         DateTime      @db.Date
  vigenciaInicial        DateTime?     @db.Date
  vigenciaFinal          DateTime?     @db.Date
  periodicidade          Periodicidade
  status                 StatusAjuste  @default(EM_ELABORACAO)

  // Previsão por fontes de recursos — quanto do valor global vem de cada esfera
  previsaoFederal   Decimal? @db.Decimal(15, 2)
  previsaoEstadual  Decimal? @db.Decimal(15, 2)
  previsaoMunicipal Decimal? @db.Decimal(15, 2)

  // Responsável pelo ajuste e sua vigência
  responsavelNome           String?
  responsavelCpf            String?   @db.VarChar(11) // só dígitos
  responsavelDataNascimento DateTime? @db.Date
  responsavelCep            String?   @db.VarChar(8)
  responsavelLogradouro     String?
  responsavelNumero         String?   @db.VarChar(20)
  responsavelComplemento    String?
  responsavelBairro         String?
  responsavelCidade         String?
  responsavelUf             String?   @db.VarChar(2)
  responsavelEmail          String?
  responsavelTelefone       String?   @db.VarChar(11) // DDD + número, só dígitos
  responsavelCargo          String?
  responsavelDataEntrada    DateTime? @db.Date
  responsavelDataSaida      DateTime? @db.Date

  // Termo de Ciência e Notificação — PDF no próprio banco, como o estatuto da
  // EntidadeBeneficiaria: `termoCienciaArquivo` fica fora do select padrão e da
  // trilha de auditoria.
  termoCienciaArquivo        Bytes?
  termoCienciaArquivoNome    String?
  termoCienciaArquivoTamanho Int?

  // Publicação do ajuste
  publicacaoLocal String?
  publicacaoLink  String?
  publicacaoData  DateTime? @db.Date

  criadoPor    String?  @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente              Cliente?             @relation(fields: [clienteId], references: [id])
  entidadeBeneficiaria EntidadeBeneficiaria @relation(fields: [entidadeBeneficiariaId], references: [id])

  termosAditivos   TermoAditivo[]
  programas        Programa[]
  planoAplicacao   PlanoAplicacaoItem[]
  cronograma       CronogramaDesembolsoItem[]
  bensCedidos      BemCedidoCadastro[]
  empenhosCadastro EmpenhoCadastro[]
  prestacoesContas PrestacaoContas[]
  projetos         Projeto[]
  tarefas          Tarefa[]
  compromissos     Compromisso[]

  @@unique([clienteId, codigoAjuste])
  @@index([entidadeBeneficiariaId])
  @@index([tipoAjuste])
}

model TermoAditivo {
  id             String   @id @default(uuid()) @db.Uuid
  ajusteId       String   @db.Uuid
  numero         String
  dataAssinatura DateTime @db.Date
  valorAcrescido Decimal? @db.Decimal(15, 2)
  valorSuprimido Decimal? @db.Decimal(15, 2)

  criadoPor String? @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  ajuste    Ajuste  @relation(fields: [ajusteId], references: [id])

  @@index([ajusteId])
}

// Plano de Metas: Programa -> Meta (com periodicidade de aferição)
model Programa {
  id       String @id @default(uuid()) @db.Uuid
  ajusteId String @db.Uuid
  nome     String

  criadoPor String? @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  ajuste    Ajuste  @relation(fields: [ajusteId], references: [id])
  metas     Meta[]

  @@unique([ajusteId, nome])
}

model Meta {
  id            String  @id @default(uuid()) @db.Uuid
  programaId    String  @db.Uuid
  codigoMeta    String
  descricao     String?
  quantificavel Boolean @default(true) // define se usa quantidade_realizada ou resultado_meta

  criadoPor String?  @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  programa  Programa @relation(fields: [programaId], references: [id])

  @@unique([programaId, codigoMeta])
}

// Importado via CSV (PlanoAplicacaoExemplo.csv)
model PlanoAplicacaoItem {
  id           String  @id @default(uuid()) @db.Uuid
  ajusteId     String  @db.Uuid
  categoria    String // ex: RECURSOS HUMANOS
  subcategoria String // ex: SALÁRIOS E ORDENADOS
  ano          Int
  mes          Int // normalizado 1-12
  valor        Decimal @db.Decimal(15, 2)
  descricao    String?

  criadoPor String? @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  ajuste    Ajuste  @relation(fields: [ajusteId], references: [id])

  @@index([ajusteId])
}

// Importado via CSV (CronogramaDesembolsoExemplo.csv)
model CronogramaDesembolsoItem {
  id       String  @id @default(uuid()) @db.Uuid
  ajusteId String  @db.Uuid
  ano      Int
  mes      Int // normalizado 1-12
  valor    Decimal @db.Decimal(15, 2)

  criadoPor String? @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  ajuste    Ajuste  @relation(fields: [ajusteId], references: [id])

  @@index([ajusteId])
}

// Importado via CSV (BensCedidosExemplo.csv)
model BemCedidoCadastro {
  id            String   @id @default(uuid()) @db.Uuid
  ajusteId      String   @db.Uuid
  identificador String // "ID" do CSV
  data          DateTime @db.Date
  valor         Decimal  @db.Decimal(15, 2)
  codigo        String

  criadoPor String? @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  ajuste    Ajuste  @relation(fields: [ajusteId], references: [id])

  @@index([ajusteId])
}

// Empenho do cadastro do Ajuste (base para o empenho_schema.json)
model EmpenhoCadastro {
  id                 String   @id @default(uuid()) @db.Uuid
  ajusteId           String   @db.Uuid
  numeroEmpenho      String   @db.VarChar(35)
  anoEmpenho         Int
  retificacao        Boolean  @default(false)
  dataEmissaoEmpenho DateTime @db.Date

  criadoPor String? @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  ajuste    Ajuste  @relation(fields: [ajusteId], references: [id])

  @@unique([ajusteId, numeroEmpenho, anoEmpenho])
}

// ============================================================================
// DOMÍNIO: AUDESP FASE V — MÓDULO PRESTAÇÃO DE CONTAS (documento JSON via API)
// ============================================================================

model PrestacaoContas {
  id              String          @id @default(uuid()) @db.Uuid
  ajusteId        String          @db.Uuid
  responsavelId   String?         @db.Uuid
  tipoDocumento   String // corresponde ao tipo do ajuste
  ano             Int // >= 2025
  mes             Int
  status          StatusPrestacao @default(EM_ELABORACAO)
  // Bloco Disponibilidades: irmão de `saldos` no JSON e OBRIGATÓRIO no schema.
  // Fica aqui por ser um valor único da prestação, não de cada conta.
  saldoFundoFixo  Decimal         @default(0) @db.Decimal(15, 2)
  protocolo       String? // retornado pela API do TCESP
  ehRetificacao   Boolean         @default(false)
  dataEnvio       DateTime?
  inconformidades Json? // lista de erros quando REJEITADO
  criadoPor       String?         @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt

  ajuste      Ajuste   @relation(fields: [ajusteId], references: [id])
  responsavel Usuario? @relation("PrestacaoResponsavel", fields: [responsavelId], references: [id])

  empregados              RelacaoEmpregado[]
  bens                    BemPrestacao[]
  contratos               Contrato[]
  documentosFiscais       DocumentoFiscal[]
  pagamentos              Pagamento[]
  disponibilidades        Disponibilidade[]
  receitas                Receita[]
  servidoresCedidos       ServidorCedido[]
  descontos               Desconto[]
  devolucoes              Devolucao[]
  glosas                  Glosa[]
  empenhos                EmpenhoPrestacao[]
  repasses                RepassePrestacao[]
  metasReportadas         RelatorioAtividadeMeta[]
  dadosGerais             DadosGeraisBeneficiaria?
  responsaveis            ResponsaveisConcessor?
  declaracoes             DeclaracoesPrestacao?
  parecerConclusivo       ParecerConclusivo?
  transparencia           Transparencia?
  demonstracoes           DemonstracoesContabeis?
  publicacaoParecerAta    PublicacaoParecerAta?
  publicacaoRelAtividades PublicacaoRelatorioAtividades?
  prestacaoEntidade       PrestacaoContasEntidade?
  relatorioFinal          RelatorioFinal?
  regulamentoCompras      RegulamentoCompras?
  extratoFisicoFinanceiro ExtratoFisicoFinanceiro?
  termoBensCedidos        TermoBensCedidos?
  ajustesSaldo            AjustesSaldo?

  @@index([responsavelId])
  @@index([ajusteId])
  @@index([status])
}

// Bloco 12 — Ajustes de Saldo (1:1): retificação/inclusão de repasses e
// pagamentos de exercícios ANTERIORES (armazenados no TCESP).
model AjustesSaldo {
  id                    String @id @default(uuid()) @db.Uuid
  prestacaoId           String @unique @db.Uuid
  retificacaoRepasses   Json   @default("[]")
  inclusaoRepasses      Json   @default("[]")
  retificacaoPagamentos Json   @default("[]")
  inclusaoPagamentos    Json   @default("[]")

  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id], onDelete: Cascade)
}

// Bloco 20 — Dados Gerais da Entidade Beneficiária (1:1): identificadores das
// certidões cadastradas/concluídas no Audesp Fase V (não são certidões locais).
model DadosGeraisBeneficiaria {
  id                           String  @id @default(uuid()) @db.Uuid
  prestacaoId                  String  @unique @db.Uuid
  identCertidaoDadosGerais     String? // tipo varia por tipo de ajuste (OS/Conveniada/OSC/OSCIP)
  identCertidaoCorpoDiretivo   String? // certidão de Corpo Diretivo (prestação de contas)
  identCertidaoMembrosConselho String? // certidão de Conselho (prestação de contas)
  identCertidaoResponsaveis    String? // Entidade Gerenciada - Responsáveis (só Contrato de Gestão)

  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id], onDelete: Cascade)
}

// Bloco 21 — Responsáveis e Membros do Órgão Concessor (1:1): identificadores
// das certidões do órgão concessor no Audesp Fase V.
model ResponsaveisConcessor {
  id                                String  @id @default(uuid()) @db.Uuid
  prestacaoId                       String  @unique @db.Uuid
  identCertidaoResponsaveis         String?
  identCertidaoComissaoAvaliacao    String?
  identCertidaoControleInterno      String?
  identCertidaoFiscalizacaoExecucao String? // só Convênio, Termo de Colaboração e Fomento

  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id], onDelete: Cascade)
}

// Bloco 24 — Declarações (1:1): contratação de empresas de dirigentes/parentes.
model DeclaracoesPrestacao {
  id                   String   @id @default(uuid()) @db.Uuid
  prestacaoId          String   @unique @db.Uuid
  houveContratacao     Boolean? // empresas pertencentes a dirigentes/agentes/parentes
  empresasPertencentes Json     @default("[]") // [{ cnpj, cpf }]
  houveParticipacao    Boolean? // participação no quadro diretivo/administrativo
  participacoes        Json     @default("[]") // [{ cpfDirigente, cpfsContratados: [] }]
  comprasAdequadas     Boolean? // adequação ao regulamento (só Contrato de Gestão e Termo de Parceria)

  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id], onDelete: Cascade)
}

// Bloco 33 — Parecer Conclusivo (1:1): conclusão + 7 declarações de análise.
model ParecerConclusivo {
  id                   String  @id @default(uuid()) @db.Uuid
  prestacaoId          String  @unique @db.Uuid
  identificacaoParecer String?
  conclusaoParecer     Int? // 1=Favorável, 2=Favorável c/ ressalvas, 3=Desfavorável
  consideracoesParecer String? // obrigatório quando desfavorável
  declaracoes          Json    @default("[]") // [{ tipoDeclaracao 1..7, declaracao 1..3, justificativa }]

  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id], onDelete: Cascade)
}

// Bloco 34 — Transparência (1:1): sítio na internet + requisitos LAI.
model Transparencia {
  id                   String   @id @default(uuid()) @db.Uuid
  prestacaoId          String   @unique @db.Uuid
  mantemSitio          Boolean?
  sitios               Json     @default("[]") // string[] (URLs)
  requisitos781        Json     @default("[]") // [{ requisito 1..8, atende }] (Arts. 7º e 8º §1º)
  requisitos83         Json     @default("[]") // [{ requisito 1..6, atende }] (Art. 8º §3º)
  requisitosDivulgacao Json     @default("[]") // [{ requisito 1..10, atende }] (Divulgação)

  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id], onDelete: Cascade)
}

// Publicação (subestrutura reusada): { tipoVeiculo 1..10, nomeVeiculo, dataPublicacao, enderecoInternet }

// Bloco 28 — Demonstrações Contábeis (1:1).
model DemonstracoesContabeis {
  id                  String   @id @default(uuid()) @db.Uuid
  prestacaoId         String   @unique @db.Uuid
  publicacoes         Json     @default("[]") // [{ tipoVeiculo, nomeVeiculo, dataPublicacao, enderecoInternet }]
  respNumeroCrc       String?
  respCpf             String?
  respSituacaoRegular Boolean?

  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id], onDelete: Cascade)
}

// Bloco 29 — Publicações de Parecer ou Ata (1:1): itens por tipo (1..4).
model PublicacaoParecerAta {
  id          String @id @default(uuid()) @db.Uuid
  prestacaoId String @unique @db.Uuid
  itens       Json   @default("[]") // [{ tipoParecerAta 1..4, houvePublicacao, publicacoes[], conclusaoParecer 1..5 }]

  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id], onDelete: Cascade)
}

// Bloco 30 — Publicação do Relatório de Atividades (1:1; só Contrato de Gestão).
model PublicacaoRelatorioAtividades {
  id                       String   @id @default(uuid()) @db.Uuid
  prestacaoId              String   @unique @db.Uuid
  houvePublicacaoExercicio Boolean?
  publicacoes              Json     @default("[]")

  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id], onDelete: Cascade)
}

// Bloco 32 — Prestação de Contas da Entidade Beneficiária (1:1): 3 datas.
model PrestacaoContasEntidade {
  id                       String  @id @default(uuid()) @db.Uuid
  prestacaoId              String  @unique @db.Uuid
  dataPrestacao            String? // ISO 'YYYY-MM-DD'
  periodoReferenciaInicial String?
  periodoReferenciaFinal   String?

  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id], onDelete: Cascade)
}

// Blocos 25/26/27 — Relatório Final da fiscalização (mesma estrutura; só um se
// aplica por tipo: Comissão de Avaliação (CG), Governamental (Convênio) ou
// Monitoramento e Avaliação (Colaboração/Fomento)).
model RelatorioFinal {
  id            String   @id @default(uuid()) @db.Uuid
  prestacaoId   String   @unique @db.Uuid
  houveEmissao  Boolean?
  conclusao     Int? // 1=Favorável s/ ressalvas, 2=c/ ressalvas, 3=Desfavorável
  justificativa String? // obrigatório se desfavorável

  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id], onDelete: Cascade)
}

// Bloco 22 — Publicação do Regulamento de Compras (1:1; só Contrato de Gestão).
model RegulamentoCompras {
  id                      String   @id @default(uuid()) @db.Uuid
  prestacaoId             String   @unique @db.Uuid
  houvePublicacaoInicial  Boolean?
  publicacoesInicial      Json     @default("[]")
  houveAlteracao          Boolean?
  houvePublicacaoAlterado Boolean?
  publicacoesAlteracao    Json     @default("[]")

  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id], onDelete: Cascade)
}

// Bloco 23 — Publicação do Extrato de Execução Física e Financeira (1:1; só Termo de Parceria).
model ExtratoFisicoFinanceiro {
  id                    String   @id @default(uuid()) @db.Uuid
  prestacaoId           String   @unique @db.Uuid
  haExtrato             Boolean?
  extratoConformeModelo Boolean?
  publicacoes           Json     @default("[]")

  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id], onDelete: Cascade)
}

// Bloco 31 — Termo da Relação de Bens Cedidos (1:1; só Contrato de Gestão).
model TermoBensCedidos {
  id                   String   @id @default(uuid()) @db.Uuid
  prestacaoId          String   @unique @db.Uuid
  termoCessaoPermissao Boolean?

  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id], onDelete: Cascade)
}

model RelacaoEmpregado {
  id                String    @id @default(uuid()) @db.Uuid
  prestacaoId       String    @db.Uuid
  cpf               String    @db.VarChar(11)
  dataAdmissao      DateTime  @db.Date
  dataDemissao      DateTime? @db.Date
  cbo               String    @db.VarChar(6)
  cns               String?   @db.VarChar(15) // obrigatório p/ médicos (CBO subgrupo 225)
  salarioContratual Decimal   @db.Decimal(15, 2)
  periodos          Json // [{ mes, carga_horaria, remuneracao_bruta }]

  criadoPor String?         @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id])

  @@unique([prestacaoId, cpf, dataAdmissao])
}

model BemPrestacao {
  id               String   @id @default(uuid()) @db.Uuid
  prestacaoId      String   @db.Uuid
  categoria        String // MOVEL_ADQUIRIDO, MOVEL_CEDIDO, MOVEL_BAIXADO, IMOVEL_*...
  numeroPatrimonio String?
  descricao        String
  data             DateTime @db.Date // aquisição/cessão/baixa conforme categoria
  valor            Decimal? @db.Decimal(15, 2) // valor_cessao obrigatório p/ móvel cedido

  criadoPor String?         @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id])

  @@index([prestacaoId])
}

model Contrato {
  id                       String        @id @default(uuid()) @db.Uuid
  prestacaoId              String        @db.Uuid
  numero                   String
  credorTipoDoc            TipoDocumento
  credorNumeroDoc          String
  credorNome               String?
  dataAssinatura           DateTime      @db.Date
  vigenciaTipo             TipoVigencia
  vigenciaDataInicial      DateTime      @db.Date
  vigenciaDataFinal        DateTime?     @db.Date
  objeto                   String
  naturezaContratacao      Int[]
  naturezaOutro            String?
  criterioSelecao          Int?
  criterioSelecaoOutro     String?
  artigoRegulamentoCompras String?
  valorMontante            Decimal       @db.Decimal(15, 2)
  valorTipo                Int?

  criadoPor String?         @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  prestacao PrestacaoContas @relation(fields: [prestacaoId], references: [id])

  @@unique([prestacaoId, numero, dataAssinatura, credorTipoDoc, credorNumeroDoc])
}

model DocumentoFiscal {
  id                   String               @id @default(uuid()) @db.Uuid
  prestacaoId          String               @db.Uuid
  numero               String
  credorTipoDoc        TipoDocumento
  credorNumeroDoc      String
  credorNome           String?
  contratoNumero       String?
  descricao            String
  dataEmissao          DateTime             @db.Date
  estadoEmissor        Int?
  valorBruto           Decimal              @db.Decimal(15, 2)
  valorEncargos        Decimal              @default(0) @db.Decimal(15, 2) // >=0 e < valorBruto — é o valor_encargos do envio
  // Qual retenção o valor acima representa. Opcional: os documentos gravados
  // antes deste campo têm valor e nenhum tipo.
  retencaoTipo         TipoRetencao?
  // Opcional: os documentos gravados antes deste campo não têm espécie, e
  // exigi-la agora obrigaria a reeditar todos eles para salvar qualquer outra
  // alteração. Não é dado que o TCESP cobre.
  tipoDocumento        TipoDocumentoFiscal?
  categoriaDespesaTipo Int
  // Rubrica do Plano de Aplicação do ajuste — CONTROLE INTERNO, não transmitida.
  //
  // Guardada como TEXTO, e não como chave para PlanoAplicacaoItem, porque a
  // reimportação do CSV apaga e recria todos os itens do plano: uma FK ficaria
  // pendurada na primeira reimportação. O par categoria+subcategoria é o que
  // identifica a rubrica, e sobrevive à troca das linhas.
  propostaCategoria    String?
  propostaSubcategoria String?
  rateioProveniente    Boolean              @default(false)
  rateioPercentual     Decimal?             @db.Decimal(5, 2)

  criadoPor  String?         @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  prestacao  PrestacaoContas @relation(fields: [prestacaoId], references: [id])
  pagamentos Pagamento[]
  glosas     Glosa[]

  @@unique([prestacaoId, numero, credorTipoDoc, credorNumeroDoc])
}

model Pagamento {
