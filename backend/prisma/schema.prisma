// ============================================================================
// DOMÍNIO: WORKFLOW (Gestão de Projetos e Tarefas / prazos legais)
// ============================================================================

// Agrupamento de tarefas. **Ainda sem uso na aplicação**: a tarefa se liga
// direto ao Ajuste, que é o recorte que o acompanhamento usa no dia a dia.
// Fica aqui para quando um agrupamento próprio fizer falta (uma "força-tarefa"
// que atravessa vários ajustes, por exemplo) — inventar projeto invisível só
// para satisfazer uma FK criaria linha que ninguém administra.
model Projeto {
  id        String  @id @default(uuid()) @db.Uuid
  clienteId String  @db.Uuid
  ajusteId  String? @db.Uuid
  nome      String

  criadoPor String?  @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  ajuste    Ajuste?  @relation(fields: [ajusteId], references: [id])
  tarefas   Tarefa[]

  @@index([clienteId])
}

model Tarefa {
  id            String           @id @default(uuid()) @db.Uuid
  // Órgão dono da tarefa. Não dá para herdar do ajuste: tarefa avulsa não tem
  // ajuste, e é justamente ela que ficaria sem dono.
  clienteId     String?          @db.Uuid // opcional até o backfill
  projetoId     String?          @db.Uuid // agrupamento opcional (ver Projeto)
  ajusteId      String?          @db.Uuid // ajuste acompanhado; nulo em tarefa avulsa
  // Compromisso que originou a providência: da visita in loco saem as
  // pendências, e é este campo que liga a ata ao que foi feito depois.
  compromissoId String?          @db.Uuid
  responsavelId String?          @db.Uuid
  titulo        String
  descricao     String?
  prioridade    PrioridadeTarefa @default(MEDIA)
  prazoLegal    DateTime         @db.Date
  status        StatusTarefa     @default(PENDENTE)

  // Alerta do sino que originou a tarefa (`cadastro-ajuste:<id>`, `certidao:<id>`…).
  // É a chave estável do alerta, não um id de tabela: alerta não é gravado.
  // Guardá-la é o que permite ao sino saber que a providência já foi tomada.
  origemAlerta String?
  concluidaEm  DateTime? // quando saiu para CONCLUIDA — a prova de que foi feito

  criadoPor    String?  @db.Uuid // usuário que incluiu (null nos registros anteriores à auditoria)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente     Cliente?     @relation(fields: [clienteId], references: [id])
  projeto     Projeto?     @relation(fields: [projetoId], references: [id])
  ajuste      Ajuste?      @relation(fields: [ajusteId], references: [id])
  compromisso Compromisso? @relation(fields: [compromissoId], references: [id])
  responsavel Usuario?     @relation(fields: [responsavelId], references: [id])

  @@index([responsavelId])
  @@index([clienteId])
  @@index([projetoId])
  @@index([ajusteId])
  @@index([compromissoId])
  @@index([prazoLegal])
  @@index([status])
  @@index([origemAlerta])
}

/// Compromisso da agenda.
///
/// Um **evento** (acontece), não uma providência (vence) — a distinção com
/// `Tarefa` é o que justifica a tabela separada. O que sobra de uma reunião é
/// o registro do que foi tratado; o que sobra de uma tarefa é a conclusão.
///
/// **Visibilidade é regra de segurança, não de interface.** Quem enxerga o quê
/// sai de `visibilidade` + as duas tabelas de vínculo, e é aplicada na consulta
/// (ver `PrismaCompromissoRepository.filtroDeVisibilidade`) — nunca na tela.
model Compromisso {
  id        String  @id @default(uuid()) @db.Uuid
  clienteId String? @db.Uuid // raiz de tenant; opcional até o backfill
  ajusteId  String? @db.Uuid // parceria tratada; nulo em compromisso avulso

  tipo   TipoCompromisso @default(OUTRO)
  titulo String
  pauta  String?

  /// Início e fim. `diaInteiro` ignora a hora na exibição, mas as colunas
  /// continuam sendo instantes: consulta por janela de datas é uma comparação
  /// só, sem caso especial para o dia inteiro.
  inicioEm   DateTime
  fimEm      DateTime
  diaInteiro Boolean  @default(false)

  local String?
  /// Cor escolhida pelo usuário (token da paleta, não hex): a tela decide como
  /// pintar, e o tema escuro continua legível.
  cor   String?

  /// Quem enxerga. PARTICULAR vence tudo — nem administrador vê, porque perfil
  /// administrativo não é autorização para ler a agenda pessoal de ninguém.
  visibilidade VisibilidadeCompromisso @default(ORGAO)

  /// Recorrência guardada como **regra**, não como instâncias materializadas.
  /// Expandir na leitura mantém a tabela pequena e faz "editar a série"
  /// significar editar uma linha — em vez de varrer centenas de cópias.
  recorrencia          Recorrencia @default(NAO_REPETE)
  /// A cada quantos períodos (2 = a cada duas semanas). Nulo = 1.
  recorrenciaIntervalo Int?
  recorrenciaAte       DateTime?

  status        StatusCompromisso @default(AGENDADO)
  /// O que foi tratado. Só faz sentido depois de REALIZADO — é a ata.
  registro      String?
  responsavelId String?           @db.Uuid

  criadoPor    String?  @db.Uuid
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente       Cliente?                  @relation(fields: [clienteId], references: [id])
  ajuste        Ajuste?                   @relation(fields: [ajusteId], references: [id])
  responsavel   Usuario?                  @relation(fields: [responsavelId], references: [id])
  participantes CompromissoParticipante[]
  grupos        CompromissoGrupo[]
  alertas       CompromissoAlerta[]
  tarefas       Tarefa[]

  // A consulta da agenda é sempre "deste órgão, nesta janela" — daí o composto.
  @@index([clienteId, inicioEm])
  @@index([inicioEm, fimEm])
  @@index([ajusteId])
  @@index([responsavelId])
  @@index([status])
  @@index([criadoPor])
}

/// Usuário convidado para um compromisso.
///
/// Tabela própria, e não um campo dentro do compromisso, porque é **por aqui
/// que a consulta filtra**: "os compromissos que eu enxergo" é um join, não uma
/// varredura de texto.
model CompromissoParticipante {
  compromissoId String @db.Uuid
  usuarioId     String @db.Uuid

  compromisso Compromisso @relation(fields: [compromissoId], references: [id], onDelete: Cascade)
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])

  @@id([compromissoId, usuarioId])
  // O índice do usuário é o que serve à pergunta "o que é meu?".
  @@index([usuarioId])
}

/// Grupo convidado para um compromisso.
///
/// O vínculo é com o **grupo**, não com a lista de membros do momento: quem
/// entrar no grupo depois passa a enxergar os compromissos dele sem que nada
/// precise ser reprocessado, que é o comportamento esperado de uma agenda de
/// equipe.
model CompromissoGrupo {
  compromissoId String @db.Uuid
  grupoId       String @db.Uuid

  compromisso Compromisso  @relation(fields: [compromissoId], references: [id], onDelete: Cascade)
  grupo       GrupoUsuario @relation(fields: [grupoId], references: [id])

  @@id([compromissoId, grupoId])
  @@index([grupoId])
}

/// Lembrete de um compromisso — **dentro do sistema**, no sino.
///
/// Guarda a **antecedência**, não o instante de disparo: se a reunião mudar de
/// hora, o lembrete acompanha sozinho. Instante gravado viraria alerta de um
/// horário que já não existe.
///
/// Não há canal de e-mail. Modelar um que nada dispara seria pior que não ter:
/// a estrutura sugere que funciona, e o usuário confia num aviso que nunca vem.
/// Se o e-mail entrar depois, a coluna volta — junto com o processo que a usa.
model CompromissoAlerta {
  id            String @id @default(uuid()) @db.Uuid
  compromissoId String @db.Uuid
  minutosAntes  Int

  compromisso Compromisso @relation(fields: [compromissoId], references: [id], onDelete: Cascade)

  @@unique([compromissoId, minutosAntes])
}

// ============================================================================
// TABELAS DE DOMÍNIO OFICIAIS (somente leitura — carregadas por seed)
// ============================================================================
// Códigos publicados pelo TCESP/MTE. NÃO são editáveis pela aplicação: são
// recarregados pelo seed (`npm run seed:dominios`) a partir dos arquivos em
// `Documentação/`. Informar código inexistente causa rejeição no envio, por
// isso os formulários consultam estas tabelas em vez de aceitar texto livre.

// Código Brasileiro de Ocupações (CBO 2002) — campo `cbo` da Relação de
// Empregados. O subgrupo 225 identifica médicos, para quem o CNS é exigido.
model Cbo {
  codigo     String @id @db.VarChar(6)
  titulo     String
  buscaTexto String // título normalizado (sem acento/caixa) para busca

  @@index([buscaTexto])
}

// Tabela Auxiliar "Classificação Econômica da Despesa" do TCESP — campo
// `classificacao_economica_tipo` dos Empenhos. A validade é por exercício e
// por esfera do ente (E=Estado, M=Municípios, C=Consórcios).
model ClassificacaoEconomica {
  codigo       String  @db.VarChar(8) // categoria+grupo+modalidade+elemento+subelemento
  exercicio    Int
  categoria    String  @db.VarChar(1)
  grupo        String  @db.VarChar(1)
  modalidade   String  @db.VarChar(2)
  elemento     String  @db.VarChar(2)
  subelemento  String  @db.VarChar(2)
  nome         String
  escrituracao String? // 'E' = obrigatório na execução · 'O' = só orçamento
  entes        String // combinação de E/M/C conforme a planilha
  situacao     String? // INCLUSAO/ALTERACAO nesta edição (excluídos não são carregados)
  buscaTexto   String

  @@id([exercicio, codigo])
  @@index([buscaTexto])
}

// Tabelas auxiliares que compõem a classificação econômica (mesmas planilhas).
// `tipo` distingue: CATEGORIA_ECONOMICA, GRUPO_NATUREZA, MODALIDADE_APLICACAO,
// ELEMENTO_DESPESA.
model ComponenteDespesa {
  tipo       String
  codigo     String @db.VarChar(2)
  nome       String
  buscaTexto String

  @@id([tipo, codigo])
}

// ============================================================================
// AUDITORIA
// ============================================================================
// Trilha de alterações e exclusões, gravada pela extension do Prisma Client
// (`extensaoAuditoria`). A tabela é **append-only**: a aplicação nunca atualiza
// nem exclui um registro daqui, e ela fica fora da própria auditoria.
//
// Criação de cadastro NÃO gera registro: a autoria da inclusão fica no campo
// `criadoPor` do próprio cadastro.

enum AcaoAuditoria {
  ALTERACAO
  EXCLUSAO
  INATIVACAO // soft delete: `ativo` passou a false
  REATIVACAO // `ativo` voltou a true
  CRIACAO // só para blocos da prestação, que não têm `criadoPor`
  /// Alguém revelou dados pessoais que a tela mostra mascarados (LGPD art. 37:
  /// registro das operações de tratamento). Não altera nada — só registra.
  VISUALIZACAO
}

model RegistroAuditoria {
  id                String        @id @default(uuid()) @db.Uuid
  // Órgão dono do evento — sem isto a trilha era a única listagem do sistema
  // que atravessava o recorte por tenant: um Administrador da Prefeitura A
  // enxergava quem alterou o quê na Prefeitura B, com `registroDescricao`
  // (razão social, nome) e o diff inteiro junto.
  //
  // Sem FK, como o resto desta tabela: ela é append-only e precisa continuar
  // legível mesmo que o órgão seja removido.
  clienteId         String?       @db.Uuid
  ocorridoEm        DateTime      @default(now())
  // Autor desnormalizado: o log precisa continuar legível se o usuário for
  // excluído depois. Sem FK, pelo mesmo motivo.
  usuarioId         String?       @db.Uuid
  usuarioNome       String        @default("(sistema)")
  entidade          String // nome do model, ex.: "Fornecedor"
  registroId        String // id do registro afetado
  // Descrição legível do registro no momento do evento (razão social, nome,
  // número). Capturada aqui porque, após a exclusão, não há mais onde lê-la.
  registroDescricao String?
  acao              AcaoAuditoria
  // ALTERACAO: só os campos que mudaram, como { campo: { de, para } }.
  // EXCLUSAO: o registro completo, é a última chance de saber o que havia.
  alteracoes        Json?
  rota              String? // ex.: "PUT /api/fornecedores/:id"

  // A listagem da tela é sempre "deste órgão, mais recente primeiro" — o
  // recorte por tenant entrou em toda consulta e o índice acompanha. Fica na
  // frente do `[ocorridoEm]` puro, que ainda serve aos scripts sem órgão.
  @@index([clienteId, ocorridoEm])
  @@index([entidade, registroId])
  @@index([ocorridoEm])
  @@index([usuarioId])
}
