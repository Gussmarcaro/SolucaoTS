# Variáveis de produção. Copie para backend/.env e preencha o que está marcado.
#
#   chmod 600 backend/.env
#
# O arquivo tem o segredo do JWT e a senha do banco: não versione, não copie
# para lugar nenhum que não precise dele.

NODE_ENV=production
PORT=3333

# --- Banco -----------------------------------------------------------------
# A senha é a criada no passo 2 do roteiro. `localhost` de propósito: o
# PostgreSQL não é exposto na internet.
DATABASE_URL=postgresql://solucao:TROQUE_A_SENHA@localhost:5432/solucaots

# --- Autenticação ----------------------------------------------------------
# Gere com: openssl rand -base64 48
# Quem descobre este segredo emite token válido para qualquer usuário.
JWT_SECRET=TROQUE_POR_UM_SEGREDO_LONGO_E_ALEATORIO
JWT_EXPIRES=8h
JWT_EXPIRES_REMEMBER=30d
RESET_TOKEN_TTL_MIN=30

# --- Endereço --------------------------------------------------------------
# Usado nos links de e-mail (redefinição de senha).
APP_URL=https://app.seudominio.com.br

# CORS: como o nginx serve o frontend no MESMO domínio da API, o navegador
# nunca faz requisição entre origens. Deixe a sua URL mesmo assim — sem a
# variável, a API libera qualquer origem.
CORS_ORIGIN=https://app.seudominio.com.br

# Um salto: o nginx é o único proxy à frente. Sem isto, o `req.ip` de todos
# seria o do nginx, e as dez primeiras senhas erradas trancariam o sistema
# inteiro. Confiar em todos deixaria forjar o cabeçalho e escapar do limite.
TRUST_PROXY=1

# --- Opcionais -------------------------------------------------------------
# Sem a chave, o Assistente da Fase V some da barra (não quebra nada).
# ANTHROPIC_API_KEY=

# Sem o DSN, nada é enviado ao Sentry.
# SENTRY_DSN=

# Versão publicada, para agrupar erros por release no painel.
# APP_RELEASE=
