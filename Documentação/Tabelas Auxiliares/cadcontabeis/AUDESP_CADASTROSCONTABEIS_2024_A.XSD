							</xs:restriction>
						</xs:simpleType>
					</xs:element>
					<xs:element name="CodigoAplicacaoVariavel">
						<xs:simpleType>
							<xs:restriction base="xs:integer">
								<xs:minInclusive value="1"/>
								<xs:maxInclusive value="9999"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:element>
				</xs:sequence>
				<xs:sequence>
					<xs:element name="CodigoAplicacaoFixoFUNDEB">
						<xs:simpleType>
							<xs:restriction base="xs:integer">
								<xs:enumeration value="264"/>
								<xs:enumeration value="265"/>
								<xs:enumeration value="266"/>
								<xs:enumeration value="267"/>
								<xs:enumeration value="268"/>
								<xs:enumeration value="269"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:element>
					<xs:element name="CodigoAplicacaoVariavelFUNDEB">
						<xs:simpleType>
							<xs:restriction base="xs:integer">
								<xs:enumeration value="0121"/>
								<xs:enumeration value="0221"/>
								<xs:enumeration value="0321"/>
								<xs:enumeration value="0122"/>
								<xs:enumeration value="0222"/>
								<xs:enumeration value="0322"/>
