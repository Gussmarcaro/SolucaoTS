<?xml version="1.0" encoding="ISO-8859-1"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.tce.sp.gov.br/audesp/xml/cadastroscontabeis" version="1.0" xml:lang="pt-BR"
	xmlns:aux="http://www.tce.sp.gov.br/audesp/xml/auxiliar" xmlns:cadc="http://www.tce.sp.gov.br/audesp/xml/cadastroscontabeis" xmlns:gen="http://www.tce.sp.gov.br/audesp/xml/generico"
	xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:import namespace="http://www.tce.sp.gov.br/audesp/xml/generico" schemaLocation="../generico/AUDESP_TIPOSGENERICOS_2024_A.XSD"/>
	<xs:import namespace="http://www.tce.sp.gov.br/audesp/xml/auxiliar" schemaLocation="../auxiliar/AUDESP_TABELASAUXILIARES_2024_A.XSD"/>
	<!-- Namespaces: cadcontabeis - prefixo: cadc   Conteudo: validação dos valores dos Cadastros Contabeis -->
	<!-- ========================================================================= -->
	<xs:annotation>
		<xs:documentation>
			<Data>2024-02-26</Data>
			<VersaoRevisaoAnterior/>
			<VersaoRevisaoNova>2024_A</VersaoRevisaoNova>
			<Descricao>Base-Line para 2024</Descricao>
			<Justificativa>Modelo para inicio de 2024</Justificativa>
			<Autor>DSIS</Autor>
		</xs:documentation>
	</xs:annotation> 
	<!-- ======================================================================== -->
	<!-- utlima atualização 2024-02-27  -->
	<!-- ======================================================================== -->
	<!-- CODIGO DE APLICACAO ==  parte fixa dos códigos que aceitam extensão pela entidade -->
	<!-- nas alterações, alterar tambem a definição no arquivo AUDeSP_TabelasAuxiliares  -->
	<xs:complexType name="CodigoAplicacao_t">
		<xs:sequence>
			<xs:choice>
				<xs:sequence>
					<xs:element name="CodigoAplicacaoFixo">
						<xs:simpleType>
							<xs:restriction base="xs:integer">
								<xs:enumeration value="100"/>
								<xs:enumeration value="112"/>  <!-- Incluído em 2022 -->
								<xs:enumeration value="130"/>
								<xs:enumeration value="190"/>
