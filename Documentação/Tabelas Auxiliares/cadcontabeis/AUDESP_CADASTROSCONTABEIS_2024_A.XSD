						</xs:simpleType>
					</xs:element>
				</xs:sequence>
			</xs:choice>
			<xs:element name="NomeCodigoAplicacao">
				<!-- Nome do convenio, entidade ou fundo deorigem/destinacao dos recursos.-->
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="5"/>
						<xs:maxLength value="200"/>
						<!-- alterado de 100 para 200 -->
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element minOccurs="0" name="OperacaoCadastro" type="gen:OperacaoCadastro_t"/>
		</xs:sequence>
	</xs:complexType>
	<!-- ========================================================================= -->
	<!-- DOMICILIO BANCARIO -->
	<xs:complexType name="DomicilioBancario_t">
		<xs:sequence>
			<xs:element name="CodigoBanco" type="gen:CodigoBanco_t"/>
			<xs:element name="CodigoAgencia" type="gen:CodigoAgenciaBancaria_t"/>
			<xs:element minOccurs="0" name="DVCodigoAgencia" type="gen:DigitoVerificador_t"/>
			<xs:element name="NomeAgencia">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="0"/>
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ContaCorrente" type="gen:NumeroContaCorrenteBancaria_t"/>
			<xs:element minOccurs="0" name="DVContaCorrente" type="gen:DigitoVerificador_t"/>
			<xs:element name="TipoContaCorrente" type="aux:CodigoTipoContaCorrenteBancaria_t"/>
			<xs:element name="NomeContaCorrente">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="0"/>
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<!-- Fonte de Recurso e CodigoAplicacao serao opcionais para 2018 -->
			<xs:element minOccurs="0" name="CodigoFonteRecursos" type="aux:CodigoFonteRecursos_t"/>
			<xs:element minOccurs="0" name="CodigoAplicacao" type="aux:CodigoAplicacao_t"/>
			<!--nao aceita zeros-->
			<xs:element minOccurs="0" name="OperacaoCadastro" type="gen:OperacaoCadastro_t"/>
		</xs:sequence>
	</xs:complexType>
	<!-- ========================================================================= -->
	<!-- CREDOR/FORNECEDOR/IDENTIFICACAO ESPECIAL  -->
	<xs:complexType name="Credor_t">
		<xs:sequence>
			<!-- <xs:element name="Identificacao" type="gen:IdentificacaoCadastral_t"/>  -->
			<xs:element name="Identificacao" type="gen:IdentificacaoIndividual_t"/>
			<xs:element name="Nome">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="5"/>
						<xs:maxLength value="100"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element minOccurs="0" name="Endereco" type="gen:Endereco_t"/>
			<xs:element minOccurs="0" name="Telefone" type="gen:Telefone_t"/>
			<!--<xs:element name="Tipo">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="F"/>
						<xs:enumeration value="C"/>
					</xs:restriction>
				</xs:simpleType>
				</xs:element> -->
			<!-- tag Fornecimento: deve ser preenchido apenas para fornecedor, com os materiais/serviços fornecidos -->
			<xs:element minOccurs="0" name="Fornecimento">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="5"/>
						<xs:maxLength value="100"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element maxOccurs="unbounded" minOccurs="0" name="ContaCorrente" type="gen:ContaCorrenteBancaria_t"/>
			<xs:element minOccurs="0" name="OperacaoCadastro" type="gen:OperacaoCadastro_t"/>
		</xs:sequence>
	</xs:complexType>
	<!-- ========================================================================= -->
	<!-- INSCRICAO GENERICA   -->
	<xs:complexType name="InscricaoGenerica_t">
		<xs:sequence>
			<xs:element name="InscricaoGenerica" type="gen:IdentificacaoInscricaoGenerica_t"/>
			<xs:element name="Nome">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="5"/>
						<xs:maxLength value="100"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element minOccurs="0" name="OperacaoCadastro" type="gen:OperacaoCadastro_t"/>
		</xs:sequence>
	</xs:complexType>
	<!-- ========================================================================= -->
	<!-- HISTORICO DO EMPENHO    -->
	<xs:complexType name="HistoricoEmpenho_t">
		<xs:sequence>
			<xs:element name="NumeroEmpenho" type="gen:NumeroEmpenho_t"/>
			<xs:element name="UnidadeOrcamentaria" type="gen:CodigoEntidadeContabil_t"/>
			<xs:element name="UnidadeExecutora" type="gen:CodigoEntidadeContabil_t"/>
			<xs:element minOccurs="0" name="NumeroContrato" type="gen:NumeroContrato_t"/>
			<xs:element minOccurs="0" name="NumeroProcessoNoOrgao" type="gen:NumeroProcessoNoOrgao_t"/>
			<xs:element name="Historico">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="5"/>
						<xs:maxLength value="1000"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element minOccurs="0" name="OperacaoCadastro" type="gen:OperacaoCadastro_t"/>
		</xs:sequence>
	</xs:complexType>
	<!-- ========================================================================= -->
	<!-- CONVENIO INICIAL  -->
	<xs:complexType name="ConvenioInicial_t">
		<xs:sequence>
			<xs:element name="Numero" type="gen:NumeroConvenio_t"/>
			<xs:element name="TipoConvenio" type="aux:CodigoTipoConvenio_t"/>
			<xs:element name="OrgaoConcedente">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="5"/>
						<xs:maxLength value="100"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element minOccurs="0" name="FonteRecursos" type="aux:CodigoFonteRecursos_t"/>
			<xs:element minOccurs="0" name="CodigoAplicacao" type="aux:CodigoAplicacao_t"/>
			<!-- aceita zeros -->
			<xs:element name="IdentificacaoFavorecido" type="gen:Identificacao_t"/>
			<!-- alterado para aceitar de 1 a 9 -->
			<xs:element minOccurs="0" name="Legislacao" type="aux:Legislacao_t"/>
			<xs:element minOccurs="0" name="NumeroProcessoNoOrgao" type="gen:NumeroProcessoNoOrgao_t"/>
			<xs:element name="DataAssinatura" type="gen:DataValida_t"/>
			<xs:element minOccurs="0" name="DataTermino" type="gen:DataValida_t"/>
			<xs:element name="Objeto">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="5"/>
						<xs:maxLength value="1000"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ValorConvenioInicial">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:minInclusive value="0"/>
						<xs:maxInclusive value="9999999999999.00"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element minOccurs="0" name="OperacaoCadastro" type="gen:OperacaoCadastro_t"/>
		</xs:sequence>
	</xs:complexType>
	<!-- ========================================================================= -->
	<!-- TERMOS ADITIVOS DE CONVENIO   -->
	<xs:complexType name="TermosAditivosConvenio_t">
		<xs:sequence>
			<xs:element name="NumeroTermo" type="gen:NumeroTermoAditivoConvenio_t"/>
			<xs:element name="AnoEmissao" type="gen:Ano_t"/>
			<xs:element name="NumeroConvenio" type="gen:NumeroConvenio_t"/>
			<xs:element name="DescricaoAlteracao">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="5"/>
						<xs:maxLength value="1000"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DataAssinatura" type="gen:DataValida_t"/>
			<xs:element name="ValorTermoAditivoConvenio" type="gen:DecimalValido_t"/>
			<xs:element minOccurs="0" name="OperacaoCadastro" type="gen:OperacaoCadastro_t"/>
		</xs:sequence>
	</xs:complexType>
	<!-- ========================================================================= -->
	<!-- CONTRATO INICIAL   -->
	<xs:complexType name="ContratoInicial_t">
		<xs:sequence>
			<xs:element name="Numero" type="gen:NumeroContrato_t"/>
			<xs:element name="TipoContratacao" type="aux:CodigoTipoContratacao_t"/>
			<xs:element name="IdentificacaoContratado" type="gen:Identificacao_t"/>
			<!-- alterado para aceitar de 1 a 9 -->
			<xs:element minOccurs="0" name="NumeroProcessoNoOrgao" type="gen:NumeroProcessoNoOrgao_t"/>
			<xs:element name="Objeto">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="5"/>
						<xs:maxLength value="1000"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element minOccurs="0" name="ValorGarantia">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:minInclusive value="0"/>
						<xs:maxInclusive value="9999999999999.00"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DataAssinatura" type="gen:DataValida_t"/>
			<xs:element minOccurs="0" name="DataTermino" type="gen:DataValida_t"/>
			<xs:element name="ValorContratoInicial">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:minInclusive value="0"/>
						<xs:maxInclusive value="9999999999999.00"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:choice>
				<xs:element name="DespesaComLicitacao" type="aux:DespesaComLicitacao_t"/>
				<xs:element name="DespesaSemLicitacao" type="aux:DespesaSemLicitacao_t"/>
			</xs:choice>
			<xs:element minOccurs="0" name="OperacaoCadastro" type="gen:OperacaoCadastro_t"/>
		</xs:sequence>
	</xs:complexType>
	<!-- ========================================================================= -->
	<!-- TERMOS ADITIVOS DE CONTRATO    -->
	<xs:complexType name="TermosAditivosContrato_t">
		<xs:sequence>
			<xs:element name="NumeroTermo" type="gen:NumeroTermoAditivoContrato_t"/>
			<xs:element name="AnoEmissao" type="gen:Ano_t"/>
			<xs:element name="NumeroContrato" type="gen:NumeroContrato_t"/>
			<xs:element name="DescricaoAlteracao">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="5"/>
						<xs:maxLength value="1000"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DataAssinatura" type="gen:DataValida_t"/>
			<xs:element name="ValorTermoAditivoContrato" type="gen:DecimalValido_t" />
			<xs:element minOccurs="0" name="OperacaoCadastro" type="gen:OperacaoCadastro_t"/>
		</xs:sequence>
	</xs:complexType>
	<!-- ========================================================================= -->
	<!-- CADASTROS -->
	<xs:complexType name="ListaCadastros_t">
		<xs:choice maxOccurs="unbounded" minOccurs="0">
			<xs:element name="CodigoAplicacao" type="cadc:CodigoAplicacao_t"/>
			<xs:element name="DomicilioBancario" type="cadc:DomicilioBancario_t"/>
			<xs:element name="CredorFornecedorDevedor" type="cadc:Credor_t"/>
			<xs:element name="InscricaoGenerica" type="cadc:InscricaoGenerica_t"/>
			<xs:element name="HistoricoEmpenho" type="cadc:HistoricoEmpenho_t"/>
			<xs:element name="ConvenioInicial" type="cadc:ConvenioInicial_t"/>
			<xs:element name="TermosAditivosConvenio" type="cadc:TermosAditivosConvenio_t"/>
			<xs:element name="ContratoInicial" type="cadc:ContratoInicial_t"/>
			<xs:element name="TermosAditivosContrato" type="cadc:TermosAditivosContrato_t"/>
		</xs:choice>
	</xs:complexType>
	<!-- ========================================================================= -->
	<!-- root  -->
	<xs:complexType name="CadastrosContabeis_t">
		<xs:sequence>
			<xs:element name="Descritor" type="gen:Descritor_t"/>
			<xs:element name="ListaCadastros" type="cadc:ListaCadastros_t"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="CadastrosContabeis" type="cadc:CadastrosContabeis_t"/>
	<!-- /roo -->
	<!-- ========================================================================= -->
</xs:schema>
